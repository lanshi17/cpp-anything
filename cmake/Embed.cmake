# Embeds a data file into a generated header as a raw string literal.
#
# The binary must answer offline, from any directory, without a checkout — the
# same promise `include_str!` gives the Rust build — so `data/*.json` travels
# inside the executable.
#
#   cppan_embed_file(<file> <symbol>)
#
# writes <binary-dir>/generated/cppan/<symbol>.hpp defining
# `inline constexpr std::string_view cppan::data::<symbol>`.

function(cppan_embed_file file symbol)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "cppan_embed_file: ${file} is missing")
  endif()

  file(READ "${file}" content)

  # A raw string needs a delimiter the payload cannot contain.
  set(delimiter "CPPAN_EMBED")
  set(counter 0)
  while(content MATCHES "\\)${delimiter}\"")
    math(EXPR counter "${counter} + 1")
    set(delimiter "CPPAN_EMBED_${counter}")
  endwhile()

  set(output "${CMAKE_BINARY_DIR}/generated/cppan/${symbol}.hpp")
  file(WRITE "${output}"
    "// Generated by cmake/Embed.cmake from ${file}; do not edit.\n"
    "#pragma once\n"
    "#include <cstddef>\n"
    "#include <string_view>\n"
    "namespace cppan::data {\n"
    "inline constexpr char ${symbol}[] = R\"${delimiter}(${content})${delimiter}\";\n"
    "inline constexpr std::size_t ${symbol}_size = sizeof(${symbol}) - 1;\n"
    "}  // namespace cppan::data\n")
endfunction()
