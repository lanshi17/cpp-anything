"""Injected by `cpp-anything record --from-tests`: records the suite's calls to a unit.

Placed on PYTHONPATH, so the interpreter imports it before anything else. It wraps
the unit's functions when the unit is imported, appends every call and result to
CPPAN_RECORD_OUT, and counts which lines of the unit the suite reached. Test
behaviour is unchanged: the original's result is returned and its exception is
re-raised.
"""

import atexit
import builtins
import json
import os
import sys
import threading

TARGET = r"{{MODULE}}"
TARGET_FILE = os.path.realpath(r"{{FILE}}")
OUT = r"{{OUT}}"
COVERAGE = r"{{COVERAGE}}"

_lock = threading.Lock()
_wrapped = set()
_executed = set()


def encode(value):
    if value is None or isinstance(value, bool):
        return value
    if isinstance(value, int):
        return value if -(2**63) <= value < 2**63 else {"$int": str(value)}
    if isinstance(value, float):
        return value
    if isinstance(value, str):
        return value
    if isinstance(value, (list, tuple)):
        items = [encode(item) for item in value]
        return items if isinstance(value, list) else {"$tuple": items}
    if isinstance(value, (set, frozenset)):
        return {"$set": sorted((encode(item) for item in value), key=lambda item: json.dumps(item, sort_keys=True))}
    if isinstance(value, dict):
        if all(isinstance(key, str) for key in value):
            return {key: encode(item) for key, item in value.items()}
        return {"$map": [[encode(key), encode(item)] for key, item in value.items()]}
    if isinstance(value, (bytes, bytearray)):
        import base64
        return {"$bytes": base64.b64encode(bytes(value)).decode("ascii")}
    return {"$opaque": repr(value)}


def _write(entry):
    with _lock:
        with open(OUT, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry, ensure_ascii=False) + "\n")


def _observe(name, args, kwargs, expect):
    try:
        payload = [encode(item) for item in args]
    except (TypeError, ValueError):
        return
    entry = {"fn": name, "args": payload, "expect": expect, "from_tests": True}
    if kwargs:
        entry["kwargs"] = sorted(kwargs)
    _write(entry)


def _wrap(module, name, function):
    key = (id(module), name)
    if key in _wrapped:
        return function
    _wrapped.add(key)

    def observed(*args, **kwargs):
        try:
            result = function(*args, **kwargs)
        except BaseException as error:
            _observe(name, args, kwargs, {"err": {"type": type(error).__name__, "msg": str(error)}})
            raise
        _observe(name, args, kwargs, {"ok": encode(result)})
        return result

    observed.__name__ = getattr(function, "__name__", name)
    observed.__doc__ = getattr(function, "__doc__", None)
    observed.__wrapped__ = function
    return observed


def _install(module):
    for name in dir(module):
        if name.startswith("_"):
            continue
        value = getattr(module, name, None)
        if callable(value) and not isinstance(value, type):
            setattr(module, name, _wrap(module, name, value))


def _install_target():
    """The unit may be the package itself or a module inside it: wrap whichever is
    loaded now, so `from pkg import fn` and `from pkg.mod import fn` both record."""
    for name, module in list(sys.modules.items()):
        if module is None:
            continue
        if name == TARGET:
            _install(module)


_original_import = builtins.__import__


def _import(name, globals=None, locals=None, fromlist=(), level=0):
    module = _original_import(name, globals, locals, fromlist, level)
    if name == TARGET or name.startswith(TARGET + ".") or TARGET.startswith(name + "."):
        _install_target()
    return module


builtins.__import__ = _import


def _tracer(frame, event, arg):
    if event == "call":
        return _tracer if os.path.realpath(frame.f_code.co_filename) == TARGET_FILE else None
    if event == "line":
        _executed.add(frame.f_lineno)
    return _tracer


if COVERAGE:
    sys.settrace(_tracer)
    threading.settrace(_tracer)


def _finish():
    if not COVERAGE:
        return
    try:
        with open(COVERAGE, "w", encoding="utf-8") as handle:
            json.dump({"file": TARGET_FILE, "reached": sorted(_executed)}, handle)
    except OSError:
        pass


atexit.register(_finish)
