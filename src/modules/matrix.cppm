export module cppan.matrix;
import std;

export {
// The compiler/std/standard matrix: cpp-anything's knowledge base.
//
// `data/matrix.json` is generated by `scripts/sync_matrix.py` from cppreference's
// compiler support tables and embedded in the binary, so `matrix` answers the same
// way on a machine with no network, no checkout and no C++ toolchain. The guides
// in `docs/guides/` are rendered from the same data by `matrix docs`, and
// `matrix docs --check` fails when they drift.


namespace cppan {

enum class Status : std::uint8_t { Yes, Partial, No };

[[nodiscard]] std::string_view status_label(Status status);
[[nodiscard]] bool usable(Status status);

struct Support {
  Status status = Status::No;
  std::optional<std::string> min;
  std::vector<std::string> notes;
};

enum class Kind : std::uint8_t { Core, Library };

[[nodiscard]] std::string_view kind_label(Kind kind);

struct Feature {
  std::string id;
  std::string name;
  Kind kind = Kind::Core;
  std::string standard;
  std::string macro_id;
  std::string paper;
  std::vector<std::pair<std::string, Support>> support;

  [[nodiscard]] const Support* toolchain(std::string_view name) const;
  /// The release that first implements the feature completely, if recorded.
  [[nodiscard]] std::optional<std::string> first_release(std::string_view toolchain) const;
  [[nodiscard]] std::uint32_t std_number() const;
};

struct Source {
  std::string title;
  std::string url;
  std::optional<std::string> revision;
  std::optional<std::string> timestamp;
};

struct Audit {
  std::vector<const Feature*> supported;
  std::vector<const Feature*> partial;
  std::vector<const Feature*> missing;
};

enum class MacroStatusKind : std::uint8_t {
  Available,
  TooOld,
  Partial,
  TooNew,
  Missing,
  Unknown,
};

struct MacroStatus {
  MacroStatusKind kind = MacroStatusKind::Unknown;
  std::string release;
  std::string feature;

  [[nodiscard]] bool available() const { return kind == MacroStatusKind::Available; }
};

class Matrix {
 public:
  /// Parses the embedded matrix on first use; a broken embed aborts with a message.
  [[nodiscard]] static const Matrix& get();

  std::string generated_at;
  std::vector<Feature> features;
  std::vector<std::pair<std::string, std::string>> toolchains;
  std::vector<Source> sources;
  std::vector<std::string> standards;
  std::map<std::string, std::string> msvc_titles;
  std::string license;

  [[nodiscard]] std::string toolchain_label(std::string_view id) const;
  /// Canonical toolchain id for a CLI alias (`g++`, `clang++`, `msvc`, `libc++`).
  [[nodiscard]] std::optional<std::string> resolve_toolchain(std::string_view name) const;
  [[nodiscard]] std::vector<const Feature*> features_in(std::string_view standard) const;

  /// What a given compiler release supports of one standard.
  [[nodiscard]] Audit audit(std::string_view toolchain, std::string_view version,
                            std::string_view standard) const;
  [[nodiscard]] std::optional<std::string> first_complete_core(std::string_view toolchain,
                                                               std::string_view standard) const;
  [[nodiscard]] std::optional<std::string> first_complete_library(std::string_view toolchain,
                                                                  std::string_view standard) const;
  [[nodiscard]] std::tuple<std::size_t, std::size_t, std::size_t> supported_counts(
      std::string_view toolchain, std::string_view version, std::string_view standard) const;

  /// Lookup by feature-test macro (`__cpp_lib_expected`), by id, or by name.
  [[nodiscard]] std::vector<const Feature*> lookup(std::string_view query) const;
  /// The earliest feature row that defines a feature-test macro.
  [[nodiscard]] const Feature* by_macro(std::string_view macro_name) const;
  [[nodiscard]] MacroStatus macro_available(std::string_view macro_name,
                                            std::string_view toolchain, std::string_view version,
                                            std::string_view standard) const;

 private:
  [[nodiscard]] static Matrix parse(std::string_view raw);
  [[nodiscard]] std::optional<std::string> first_complete(std::string_view toolchain,
                                                          std::string_view standard,
                                                          Kind kind) const;
};

/// The facilities cpp-anything's generated code can use, keyed by the macro
/// `profile.hpp` defines and the feature-test macro it depends on.
struct ProfileFeature {
  std::string_view define;
  std::string_view macro_id;
};
inline constexpr ProfileFeature kProfileFeatures[] = {
    {"CPPAN_HAS_CONCEPTS", "__cpp_concepts"},
    {"CPPAN_HAS_COROUTINES", "__cpp_impl_coroutine"},
    {"CPPAN_HAS_SPAN", "__cpp_lib_span"},
    {"CPPAN_HAS_RANGES", "__cpp_lib_ranges"},
    {"CPPAN_HAS_RANGES_TO", "__cpp_lib_ranges_to_container"},
    {"CPPAN_HAS_FORMAT", "__cpp_lib_format"},
    {"CPPAN_HAS_PRINT", "__cpp_lib_print"},
    {"CPPAN_HAS_EXPECTED", "__cpp_lib_expected"},
    {"CPPAN_HAS_MDSPAN", "__cpp_lib_mdspan"},
    {"CPPAN_HAS_STACKTRACE", "__cpp_lib_stacktrace"},
    {"CPPAN_HAS_FLAT_MAP", "__cpp_lib_flat_map"},
    {"CPPAN_HAS_GENERATOR", "__cpp_lib_generator"},
    {"CPPAN_HAS_THREE_WAY", "__cpp_impl_three_way_comparison"},
    {"CPPAN_HAS_DEDUCING_THIS", "__cpp_explicit_this_parameter"},
    {"CPPAN_HAS_MODULES", "__cpp_modules"},
    {"CPPAN_HAS_LIB_MODULES", "__cpp_lib_modules"},
    {"CPPAN_HAS_SOURCE_LOCATION", "__cpp_lib_source_location"},
    {"CPPAN_HAS_BIT_CAST", "__cpp_lib_bit_cast"},
    {"CPPAN_HAS_TO_CHARS_FLOAT", "__cpp_lib_to_chars"},
};

/// `profile.hpp`: the header every generated project includes, claiming exactly
/// what the target toolchain has.
[[nodiscard]] std::string render_profile(std::string_view toolchain, std::string_view version,
                                         std::string_view standard);
[[nodiscard]] std::string_view std_macro(std::string_view standard);

}  // namespace cppan
}
